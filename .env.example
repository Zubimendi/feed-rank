# FeedRank — environment variables
# Copy to .env and fill in values for local development.
# All variables have sane defaults for docker-compose usage.

# Postgres connection string
DATABASE_URL=postgres://feedrank:feedrank@localhost:5432/feedrank?sslmode=disable

# Redis address (host:port — no scheme)
REDIS_URL=localhost:6379

# HTTP port for the API server
PORT=8080

# Follower count at which an account is treated as a celebrity.
# Accounts at/above this threshold have posts stored in celebrity_posts:{id}
# instead of being fanned out to all followers.
CELEBRITY_THRESHOLD=10000

# Maximum posts stored per user's Redis timeline sorted set.
# Older entries are trimmed on every write. Postgres is the fallback.
TIMELINE_CAP=500

# Fan-out strategy.
#   hybrid — fan-out-on-write for normal accounts, fan-out-on-read for celebrities.
#   pure   — fan-out-on-write for ALL accounts (load test control condition).
FANOUT_MODE=hybrid
